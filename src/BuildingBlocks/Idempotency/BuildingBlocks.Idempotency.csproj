<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <RootNamespace>BuildingBlocks.Idempotency</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BuildingBlocks.Idempotency</PackageId>
    <Title>BuildingBlocks.Idempotency</Title>
    <Version>1.0.1</Version>
    <Authors>Mohammad Hasan Hosseini</Authors>
    <Company>Mohammad Hasan Hosseini</Company>
    <Copyright>Copyright (c) 2026 Mohammad Hasan Hosseini</Copyright>
    <Description>ASP.NET Core HTTP Idempotency-Key filter (MVC + Minimal API): shared IdempotencyGate over IDistributedCache, 2xx response envelope replay, RFC 9457 ProblemDetails errors, optional Redis SET NX lock, ProcessingTtl abandoned recovery, opt-in method+path+body fingerprinting, per-endpoint TTL, and optional ActivitySource instrumentation. Host owns cache registration. Uses System.Text.Json. No MCP or Telemetry package coupling.</Description>
    <PackageTags>idempotency;idempotency-key;aspnetcore;minimal-api;redis;distributed-lock;distributed-cache;fingerprint;problemdetails;opentelemetry;net8;net9;net10</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Maxofpower/FeatureFusion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxofpower/FeatureFusion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageIcon>idempotency-icon.png</PackageIcon>
    <PackageReleaseNotes>1.0.1: package icon; System.Text.Json for cache + MVC ObjectResult (drop Newtonsoft.Json). https://github.com/Maxofpower/FeatureFusion/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
    <None Include="AGENTS.md" Pack="true" PackagePath="\" />
    <None Include="idempotency-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Ulid" Version="1.3.4" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuildingBlocks.Idempotency.Tests" />
  </ItemGroup>

</Project>
